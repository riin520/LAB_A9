<?xml version="1.0" encoding="utf-8"?>
<!-- Gốc là LinearLayout ngang, KHÔNG có ScrollView[cite: 69] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgAnh"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/desc_anh"
        android:scaleType="centerCrop" /> <!-- centerCrop để ảnh không bị méo[cite: 69] -->

    <!-- Khối text dùng layout_weight="1" để chiếm phần giữa[cite: 69] -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" /> <!-- ellipsize="end" và maxLines="1" chặn rớt dòng[cite: 69] -->

        <TextView
            android:id="@+id/tvMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>